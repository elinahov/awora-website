# Supabase project (Settings → API). Leave empty to run on the bundled seed data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Server only (Vercel → Settings → Environment Variables; also read by `npm run dev`). Never prefix with VITE_.
# Same URL as above; the service role key bypasses RLS and is used only by /api/order.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Resend (resend.com → API Keys). Until you verify a domain, Resend only delivers to your own Resend account email.
RESEND_API_KEY=
# Sender, e.g. "Awora <orders@your-domain.am>" once the domain is verified in Resend.
RESEND_FROM=Awora <onboarding@resend.dev>
# Where new-order emails go.
ORDER_NOTIFY_EMAIL=eleenehovak@gmail.com
# Public site URL, used for the "open in admin" link in emails, e.g. https://awora.am
SITE_URL=
